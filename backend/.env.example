# Copy to .env and fill in. Loaded via python-dotenv (override=False) by the
# API server and the CLI. Most users never touch a .env: `penny init` writes
# the same answers to the workspace config.toml, which every entrypoint loads
# as environment DEFAULTS (a real env var — including one from this file —
# always wins).

# --- Model providers ---
# Penny's agent runs on Gemini (gemini-3.6-flash). The categorizer defaults
# to the same model via PENNY_CATEGORIZER_MODEL below.
GOOGLE_API_KEY=...
# Optional fallbacks — only needed if you switch agent_factory to another provider.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# Required only when PENNY_AGENT_MODEL names an OpenRouter model (see below).
# OPENROUTER_API_KEY=sk-or-...

# --- Agent & categorizer models ---
# Model used for transaction categorization (provider inferred from name).
# Unset, it falls back to PENNY_AGENT_MODEL (see penny/config.py).
PENNY_CATEGORIZER_MODEL=gemini-3.6-flash
# Chat agent model; defaults to gemini-3.6-flash (penny/config.py DEFAULT_AGENT_MODEL).
# The provider follows from the name — no separate provider var to keep in sync.
# Gemini ids go to Google; OpenRouter ids are namespaced vendor/model and need
# OPENROUTER_API_KEY above:
#   PENNY_AGENT_MODEL=moonshotai/kimi-k3   # Kimi K3
#   PENNY_AGENT_MODEL=z-ai/glm-5.2         # GLM-5.2
# PENNY_AGENT_MODEL=gemini-3.6-flash
# Optional: PENNY_AGENT_PROVIDER / PENNY_AGENT_REASONING_EFFORT /
# PENNY_AGENT_VERBOSITY / PENNY_ENABLE_WEB_SEARCH (see penny/config.py).
# Thinking-token budget for the chat agent. Defaults per model dialect: -1 on
# Gemini (dynamic; 0 disables thinking and with it the streamed thought
# summaries in the UI), 8192 on OpenRouter (Anthropic shape, where a negative
# budget_tokens is rejected).
# PENNY_AGENT_THINKING_BUDGET=-1
# Merchant normalizer model (defaults sensibly; see penny/normalizer).
# PENNY_NORMALIZER_MODEL=...

# --- Database ---
# One single-player database holding finance + app_* tables. Defaults to
# sqlite:///./penny.db when unset; `penny init` points it at the workspace
# (~/.penny/penny.db). A bare path is normalized to a sqlite URL, and
# postgres:// to postgresql:// (penny/db.py). PENNY_DATABASE_URL is
# preferred; DATABASE_URL is still accepted.
# PENNY_DATABASE_URL=sqlite:///./penny.db

# --- Workspace ---
# Root for memory/, reports/, logs/, config.toml, and the user id. Defaults
# to ~/.penny — unless an existing ~/.transactoid is found, which is used
# as-is so prior-product state carries over.
# PENNY_WORKSPACE=~/.penny

# --- Plaid ---
PLAID_CLIENT_ID=...
PLAID_ENV=production            # sandbox | development | production
# The secret var is per-environment: the client reads PLAID_<ENV>_SECRET.
PLAID_SANDBOX_SECRET=...
PLAID_PRODUCTION_SECRET=...
# Link flow: `hosted` runs react-plaid-link in the browser with a server-side
# token exchange (POST /api/plaid/exchange); `localhost` keeps the dev
# connect_new_account browser flow. Default hosted. Linking is a desktop
# action against the LOCAL server (phones are a read/chat surface).
PENNY_PLAID_LINK_MODE=hosted     # hosted | localhost
# OAuth redirect URI for hosted Link (must be allow-listed in the Plaid
# dashboard); include the app URL the card returns to. Optional in localhost.
PLAID_REDIRECT_URI=...

# --- Email (weekly report delivery; direct SMTP by default) ---
# The proven Gmail path: SMTP_HOST=smtp.gmail.com + an app password. A local
# MTA works via SMTP_HOST=localhost. Set EMAIL_PROVIDER=resend to use Resend
# instead (requires a verified sender domain + RESEND_API_KEY).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@example.com
# SMTP_PASSWORD=...
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# EMAIL_FROM=you@example.com        # defaults to SMTP_USERNAME
# EMAIL_FROM_NAME=Penny Reports
# EMAIL_PROVIDER=smtp               # smtp | resend
# RESEND_API_KEY=re_...
# Report recipient email(s), comma-separated. Recipients come from config
# only — never from the prompt or the model.
# PENNY_REPORT_RECIPIENTS=you@example.com

# --- Cloudflare R2 (optional report/artifact uploads + investment-dedup archive) ---
# R2_ACCOUNT_ID=...
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET=...

# --- Amazon scraping (optional; Browserbase-backed) ---
# BROWSERBASE_API_KEY=...
# BROWSERBASE_PROJECT_ID=...

# --- Langfuse tracing (optional observability) ---
# Traces the agent loop (chat + daemon jobs) and the categorizer. Tracing
# turns on automatically when both keys are present; no-op otherwise.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://us.cloud.langfuse.com   # or https://cloud.langfuse.com (EU)
# Explicit on/off override (defaults to: on iff both keys are set):
# PENNY_LANGFUSE_ENABLED=true
# Optional environment tag shown in the Langfuse UI:
# PENNY_LANGFUSE_ENVIRONMENT=development

# --- Sentry error tracking (optional) ---
# Ships unhandled exceptions from the API + CLI to Sentry. On by default
# using the project DSN baked into penny/observability/sentry.py (a Sentry
# DSN is a public client key). Override or disable here:
# PENNY_SENTRY_DSN=            # set empty to disable; unset uses the default DSN
# PENNY_SENTRY_ENABLED=true    # explicit on/off (defaults to: on iff a DSN resolves)
# PENNY_SENTRY_ENVIRONMENT=development

# --- Security ---
# Fernet key encrypting plaid_items.access_token at rest (v1-stamped; see
# penny/security/token_cipher.py). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Optional in single-player: unset stores tokens plaintext in your own local
# DB file; migration 017 encrypts the backlog once the key is configured.
# PENNY_PLAID_TOKEN_KEY=...
# Key rotation (non-destructive): add the new version's key here, bump
# _ACTIVE_VERSION in token_cipher.py, and KEEP the prior key(s) set so
# existing v1: ciphertext still decrypts. Prior/other versions read from
# PENNY_PLAID_TOKEN_KEY_V<N> (v1 also reads PENNY_PLAID_TOKEN_KEY above).
# PENNY_PLAID_TOKEN_KEY_V2=...

# --- run_sql read-only role (Postgres only) ---
# The agent's free-form run_sql is guarded by the input parse guard
# (security/sql_read_guard.py, REQUIREMENTS T2a) everywhere; on Postgres it
# can additionally run on a dedicated SELECT-only role so a prompt-injected
# write is rejected by the database itself. SQLite has no roles — the parse
# guard is the layer there.
# PENNY_AGENT_READONLY_DATABASE_URL=postgresql://penny_ro:...@host/db

# --- One-shot scripts ---
# Source DB for scripts/sync_taxonomy_from_supabase.py. Kept separate from
# the runtime DB URL so dev never accidentally talks to prod at runtime.
# SUPABASE_DATABASE_URL=postgresql://...
