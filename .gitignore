# Python
__pycache__/
*.py[cod]
.venv/

# Secrets / local env (keep .env.example tracked)
.env
.env.*
!.env.example

# Per-worktree PENNY_WORKSPACE override (not symlinked like .env/.env.*;
# see backend/penny/cli.py and backend/penny/api/main.py)
backend/.penny-workspace

# Convention target for the above: an isolated per-worktree workspace dir
.dev-workspace/

# Node
node_modules/
dist/

# Build / tooling caches
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Runtime artifacts (LLM response cache, categorizer JSON logs)
.cache/
.logs/

# Descriptor sampling output — contains real (prod-mirrored) merchant strings
.descriptor-corpus/

# Local databases
*.db
*.sqlite
*.sqlite3

# Git worktrees
.worktrees/
.claude/worktrees/

# Local Penny workspace clone (versioned separately in penny-workspace)
.penny/
.transactoid/

# Plaid Link localhost HTTPS certs
.certs/

# Playwright MCP session logs/screenshots
.playwright-mcp/

# Python packaging metadata
*.egg-info/

# OS / editor
.DS_Store
*.log
*.tsbuildinfo
